rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidTrip(data) {
      return data.keys().hasAll(['name', 'destination', 'startDate', 'endDate', 'budget', 'userId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'destination', 'startDate', 'endDate', 'budget', 'userId', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.destination is string && data.destination.size() <= 100 &&
             data.budget is number && data.budget >= 0 &&
             data.userId == request.auth.uid;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['tripId', 'amount', 'category', 'date', 'description', 'userId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['tripId', 'amount', 'category', 'date', 'description', 'userId', 'createdAt', 'updatedAt']) &&
             data.amount is number && data.amount >= 0 &&
             data.category in ['Food', 'Transport', 'Accommodation', 'Activities', 'Shopping', 'Other'] &&
             data.description is string && data.description.size() <= 200 &&
             data.userId == request.auth.uid;
    }

    // Trips Collection
    match /trips/{tripId} {
      allow get: if isOwner(existing().userId);
      allow list: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && 
                      isValidTrip(incoming()) && 
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time;
      allow update: if isOwner(existing().userId) && 
                      isValidTrip(incoming()) && 
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time;
      allow delete: if isOwner(existing().userId);
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow get: if isOwner(existing().userId);
      allow list: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && 
                      isValidExpense(incoming()) && 
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time &&
                      exists(/databases/$(database)/documents/trips/$(incoming().tripId));
      allow update: if isOwner(existing().userId) && 
                      isValidExpense(incoming()) && 
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time;
      allow delete: if isOwner(existing().userId);
    }
  }
}
